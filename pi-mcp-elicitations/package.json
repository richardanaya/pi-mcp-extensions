{
  "name": "pi-mcp-elicitations",
  "version": "0.1.0",
  "description": "pi extension: MCP elicitation client (form, URL, and multi round-trip requests) over pi's registered MCP servers",
  "license": "MIT",
  "author": "Richard Anaya",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richardanaya/pi-mcp-extensions.git",
    "directory": "pi-mcp-elicitations"
  },
  "homepage": "https://github.com/richardanaya/pi-mcp-extensions/tree/main/pi-mcp-elicitations#readme",
  "bugs": {
    "url": "https://github.com/richardanaya/pi-mcp-extensions/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "mcp",
    "elicitation",
    "sep-1036",
    "sep-2322"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@types/node": "^22.15.0",
    "typebox": "1.3.27",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@earendil-works/pi-mcp": "1.3.0"
  }
}
