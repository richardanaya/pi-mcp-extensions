    "type": "git",
    "url": "git+https://github.com/richardanaya/pi-mcp-apps.git"
  },
  "homepage": "https://github.com/richardanaya/pi-mcp-apps#readme",
  "bugs": {
    "url": "https://github.com/richardanaya/pi-mcp-apps/issues"
  },
  "keywords": ["pi-package", "pi", "mcp", "apps", "sep-1865"],
  "pi": { "extensions": ["./index.ts"] },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@types/node": "^22.15.0",
    "typebox": "1.3.27",
    "typescript": "^5.8.3"
  }
}
